# Copy to .env and replace API_ACCESS_TOKEN with a long random value.
API_ACCESS_TOKEN=change-me-before-running
API_HOST=127.0.0.1
API_PORT=3001
TEMPORAL_ADDRESS=127.0.0.1:7233
OPTIMUS_DATA_DIR=./data
APPROVED_REPOS=ElyRand/Optimus
# No real GitHub write action is implemented in this starter.
LIVE_HARNESS=false
AGENT_HARNESS=codex
# Optional model override for the selected harness.
AGENT_MODEL=
# Requires Docker Sandboxes installed, authenticated, and a real allowed repo.
# Slack is OPTIONAL. Keep credentials OUT of the sandbox.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_OWNER_ID=
