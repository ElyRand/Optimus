{
  "name": "optimus-local-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "node --watch --import tsx apps/api/src/index.ts",
    "dev:worker": "node --watch --import tsx apps/worker/src/index.ts",
    "dev:web": "npm run dev -w @optimus/web",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "build": "npm run build -w @optimus/web"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@slack/bolt": "^4.0.0",
    "@slack/web-api": "^7.0.0",
    "@tanstack/ai": "1.0.0",
    "@tanstack/ai-claude-code": "1.0.0",
    "@tanstack/ai-codex": "1.0.0",
    "@tanstack/ai-sandbox": "1.0.0",
    "@tanstack/ai-sandbox-docker": "1.0.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.0",
    "hono": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "@temporalio/testing": "1.24.0"
  }
}
